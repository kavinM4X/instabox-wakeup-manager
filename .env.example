# ==============================================================================
# InstaBox Wakeup Manager - Example Environment File
# ==============================================================================
# Copy this file to .env for local script execution and testing:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit your real .env file or API keys to version control.
# - In GitHub Actions, configure these via Repository Secrets and Variables.
# ==============================================================================

# [REQUIRED] InstaBox API Key
# Generated from the InstaBox dashboard or CLI.
# Required scopes:
#   - machines:read  (required for check-machine.sh)
#   - machines:write (required for resume-machine.sh)
INSTABOX_API_KEY=your_instabox_api_key_here

# [OPTIONAL / RECOMMENDED] Target Machine Name
# Name of the InstaBox machine to monitor/resume (defaults to test-app if omitted).
INSTABOX_MACHINE=test-app

# [OPTIONAL] InstaBox API Base URL
# Default is https://api.instabox.sh. Only override if using a custom gateway.
INSTABOX_API_URL=https://api.instabox.sh

